# INITE Triad — copy to .env:   cp .env.example .env
#
# The values below boot a working stack on localhost. They are NOT secrets:
# before the stack is reachable from anywhere but this machine, replace every
# value marked [secret] (`openssl rand -base64 32` each) and set the public
# URLs to your https:// hosts (see "On a server" at the bottom and the README).

# ── Versions (official multi-arch images, linux/amd64 + linux/arm64) ─────────
# Which combinations work: §9 of the Triad contract,
# https://github.com/inite-ai/inite-ecosystem/blob/main/docs/triad-compatibility.md
# Upgrade one at a time, in this order: AUTH → BRAIN → BILLING (§10).
INITE_REGISTRY=mikefluff
AUTH_VERSION=v1.12.0
BRAIN_VERSION=v2.4.0
BILLING_VERSION=v1.4.0

# ── Public URLs ──────────────────────────────────────────────────────────────
# AUTH_PUBLIC_URL is THE issuer: Auth signs it into every token as `iss`,
# advertises it in discovery, and Brain/Billing pin it. No trailing slash.
# It must be the URL clients reach Auth at; containers fetch keys in-network.
AUTH_PUBLIC_URL=http://localhost:3002
BRAIN_PUBLIC_URL=http://localhost:3004
BILLING_PUBLIC_URL=http://localhost:3003

# Host ports, and the address they bind to (127.0.0.1 = this machine only).
BIND_ADDR=127.0.0.1
AUTH_PORT=3002
BILLING_PORT=3003
BRAIN_PORT=3004

# ── Databases ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=local-postgres-superuser          # [secret]
AUTH_DB_PASSWORD=local-auth-db                      # [secret]
BILLING_DB_PASSWORD=local-billing-db                # [secret]
SURREALDB_ROOT_PASSWORD=local-surreal-root          # [secret]
SURREALDB_SCOPED_PASSWORD=local-surreal-scoped      # [secret]

# ── Auth ─────────────────────────────────────────────────────────────────────
# The RS256 signing key is generated on the first `up` into the auth-keys
# volume (service auth-keys); nothing to set here.
AUTH_SESSION_SECRET=local-auth-session-secret-change-me            # [secret]
AUTH_REFRESH_TOKEN_HMAC_SECRET=local-auth-refresh-hmac-change-me   # [secret]
# 32 bytes, base64.
AUTH_FIELD_ENCRYPTION_KEY=bG9jYWwtZmllbGQtZW5jcnlwdGlvbi1rZXktMzJieXQ=   # [secret]
# WebAuthn relying party (passkeys): the registrable domain of AUTH_PUBLIC_URL.
AUTH_RP_ID=localhost
# Email (magic links, password reset). Unset = no mail is sent.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ── Brain ────────────────────────────────────────────────────────────────────
BRAIN_FORGET_HMAC_KEY=local-brain-forget-hmac-key-change-me-0123456789   # [secret]
# Required at boot. A placeholder (sk-…) is enough to start and to read;
# writing memory (extraction, embeddings, synthesis) needs a real key.
OPENAI_API_KEY=sk-placeholder-set-a-real-key-to-write-memory

# ── Billing ──────────────────────────────────────────────────────────────────
# Seals wallet/relayer private keys at rest. 32 bytes, base64. Keep a copy
# off the server: a lost secret is a lost key.
BILLING_KEY_SEAL_SECRET=bG9jYWwtYmlsbGluZy1rZXktc2VhbC1zZWNyZXQtMzI=   # [secret]
ANTHROPIC_API_KEY=

# ── On a server ──────────────────────────────────────────────────────────────
# Put a TLS reverse proxy (Caddy, Traefik, nginx) in front of the three ports
# and set, for example:
#   AUTH_PUBLIC_URL=https://auth.example.com
#   BRAIN_PUBLIC_URL=https://brain.example.com
#   BILLING_PUBLIC_URL=https://billing.example.com
#   AUTH_RP_ID=example.com
# Changing AUTH_PUBLIC_URL later is an issuer migration (contract §7, B-3).
